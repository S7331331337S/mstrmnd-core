{
  "schemaVersion": "1.0.0",
  "description": "Example host config for loading MSTRMND as a transportable plugin",
  "workspace": {
    "vaultPathEnv": "OBSIDIAN_VAULT_PATH",
    "mounts": [
      { "id": "vault", "adapter": "obsidian", "fromEnv": "OBSIDIAN_VAULT_PATH" }
    ]
  },
  "doctrine": {
    "pinFile": "doctrine.pin.json",
    "syncCommand": "pnpm doctrine:sync"
  },
  "model": {
    "providerEnv": "MSTRMND_MODEL_PROVIDER",
    "default": "echo",
    "openai": {
      "provider": "openai",
      "apiKeyEnv": "MSTRMND_MODEL_API_KEY",
      "baseUrlEnv": "MSTRMND_MODEL_BASE_URL",
      "modelEnv": "MSTRMND_MODEL_NAME"
    }
  },
  "mcp": {
    "command": "pnpm",
    "args": ["--filter", "@mstrmnd/mcp-server", "start"],
    "cwd": "<path-to-mstrmnd-core>",
    "env": {
      "OBSIDIAN_VAULT_PATH": "<path-to-this-operator-pack-or-vault>"
    }
  },
  "hermes": {
    "command": "pnpm hermes",
    "args": ["--goal", "Summarize operator context", "--dry-run"]
  },
  "threatBoundary": {
    "id": "operator-zero-default",
    "workflowId": "operator-zero",
    "networkAllowlist": [],
    "credentialAllowlist": [],
    "toolsAllowlist": [
      "search_memory",
      "list_workspace",
      "read_file",
      "get_context",
      "spawn_subagent"
    ],
    "filesystemScope": [
      { "mountId": "vault", "pathPrefix": "" }
    ],
    "costCeilingUsd": 1,
    "consequentialApprovals": [
      "external.communicate",
      "content.publish",
      "money.commit",
      "data.delete",
      "permission.change",
      "production.code.change",
      "contract.enter",
      "sensitive.disclose"
    ],
    "mcpAllowlist": ["mstrmnd"]
  },
  "scm": {
    "sourceOfTruth": "github",
    "env": "MSTRMND_SCM"
  }
}
