# MSTRMND core — in-container schedule (supercronic).
# Calibration needs a real provider (MSTRMND_MODEL_PROVIDER); with none configured it logs
# "skipped: no model provider" and exits 0. No test provider is used in production.

*/15 * * * * /app/infrastructure/cron-health.sh
0 * * * * cd /app && pnpm --filter @mstrmnd/host calibrate
0 4 * * * cd /app && python3 scripts/validate-doctrine.py
