# Backend origin for the MSTRMND OS agent runtime.
#
# The app is hosting-agnostic: it talks to the eve HTTP protocol at
# /eve/v1/* on whatever origin is set here. Nothing about the host is
# compiled into the bundle, so moving the backend between Vercel, a
# container (ECS / Cloud Run / Fly / Railway / VPS), or a laptop is a
# change to this one value.
#
# Leave it unset to run the app in demo mode against local mock data.

# EXPO_PUBLIC_MSTRMND_API_URL=https://os.mstrmnd.example
# EXPO_PUBLIC_MSTRMND_API_URL=http://192.168.1.20:3000
