# Copy to .env.local (gitignored) for local development.

# Vercel AI Gateway key — enables live model responses in app/api/chat+api.ts.
# Without it, the alliance runs in demo mode: real streaming, scripted replies.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional — override the default gateway model (see resolveModel in
# src/app/api/chat+api.ts). Defaults to "anthropic/claude-sonnet-4.5".
EXPO_PUBLIC_MSTRMND_MODEL=

# Required for native release builds only (dev and web resolve the API
# route automatically). Point this at your deployed server origin, e.g.
# an EAS Hosting deployment or a standalone Node server running
# `expo export -p web` + `@expo/server`.
EXPO_PUBLIC_API_BASE_URL=
