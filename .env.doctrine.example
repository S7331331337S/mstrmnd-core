# Canonical MSTRMND doctrine source
MSTRMND_DOCTRINE_REPOSITORY=S7331331337S/mstrmnd.md

# Pin a reviewed full commit SHA (never floating main/master).
# The committed source of truth is doctrine.pin.json; env overrides are for local sync.
# MSTRMND_DOCTRINE_REF=0123456789abcdef0123456789abcdef01234567

# Optional token when the doctrine repo is private (CI: repo secret MSTRMND_DOCTRINE_TOKEN)
# MSTRMND_DOCTRINE_TOKEN=
