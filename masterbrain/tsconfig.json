{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@masterbrain/agents": ["./packages/agents/index.ts"],
      "@masterbrain/agents/*": ["./packages/agents/*"],
      "@masterbrain/orchestration": ["./packages/orchestration/index.ts"],
      "@masterbrain/canon": ["./packages/canon/index.ts"],
      "@masterbrain/db": ["./packages/db/index.ts"],
      "@masterbrain/integrations/*": ["./packages/integrations/*"],
      "@masterbrain/shared": ["./packages/shared/index.ts"],
      "@masterbrain/shared/*": ["./packages/shared/*"],
      "@/*": ["./apps/masterbrain/*"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "harness/**/*.ts"]
}
