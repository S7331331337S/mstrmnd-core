# ============================================================
# MASTERBRAIN — Environment Variables
# ============================================================

# --- Anthropic (Council & HEX run on Opus; CANON queries on Haiku) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model selection — defaults are sensible, override per agent if needed
COUNCIL_MODEL=claude-opus-5
ROUTING_MODEL=claude-sonnet-5
MEMORY_MODEL=claude-haiku-4-5-20251001
ADVERSARY_MODEL=claude-opus-5

# --- Vercel AI Gateway (recommended — observability + caching) ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://gateway.ai.vercel.app/v1

# --- Supabase (CANON memory + decision ledger) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations ---
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=1211847797512831
ASANA_PROJECT_GID=1214439548096950

GITHUB_TOKEN=
GITHUB_OWNER=S7331331337S

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Auth (required — routes refuse to serve without this) ---
MASTERBRAIN_API_TOKEN=

# --- Embeddings (CANON returns no priors until this is set) ---
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3

# --- Webhooks (signing secrets) ---
WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=https://masterbrain.mstrmnd.io
NODE_ENV=development
