{
  "name": "mstrmnd-core",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "tsc --noEmit && pnpm --filter @mstrmnd/mobile run typecheck",
    "typecheck": "tsc --noEmit && pnpm --filter @mstrmnd/mobile run typecheck",
    "hermes": "pnpm --filter @mstrmnd/hermes dev",
    "mcp": "pnpm --filter @mstrmnd/mcp-server start",
    "mobile": "pnpm --filter @mstrmnd/mobile dev"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "@types/node": "latest"
  },
  "packageManager": "pnpm@10.0.0"
}
