{
  "name": "mstrmnd-core",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/intelligence-core/src/workspace-service.test.ts packages/intelligence-core/src/write-approval.test.ts packages/intelligence-core/src/orchestrator.test.ts apps/hermes/src/approval.test.ts",
    "hermes": "pnpm --filter @mstrmnd/hermes dev",
    "mcp": "pnpm --filter @mstrmnd/mcp-server start",
    "doctrine:sync": "python3 scripts/sync-doctrine.py",
    "doctrine:validate": "python3 scripts/validate-doctrine.py",
    "doctrine:ci": "python3 scripts/validate-doctrine.py --fixture",
    "verify": "pnpm typecheck && pnpm doctrine:ci && pnpm test",
    "board": "npm --prefix apps/board start",
    "board:web": "npm --prefix apps/board run web",
    "board:typecheck": "npm --prefix apps/board run typecheck",
    "board:test": "npm --prefix apps/board test",
    "board:export": "npm --prefix apps/board run export:web",
    "board:materialize": "bash apps/board/scripts/materialize-vendor.sh",
    "board:verify": "bash apps/board/scripts/materialize-vendor.sh && npm --prefix apps/board ci && npm --prefix apps/board run typecheck && npm --prefix apps/board test",
    "operator:init": "python3 scripts/init-operator-pack.py",
    "hermes:dry": "pnpm --filter @mstrmnd/hermes dev -- --dry-run"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "@types/node": "latest"
  },
  "packageManager": "pnpm@10.0.0"
}
