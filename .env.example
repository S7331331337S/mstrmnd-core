# Obsidian vault path (optional — defaults to ~/Documents/Obsidian Vault)
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault
# Operator pack dir holding boundary.json (optional — defaults to OBSIDIAN_VAULT_PATH)
# MSTRMND_OPERATOR_PACK=/Users/you/my-operator

# Model provider (default: echo — offline/CI)
# MSTRMND_MODEL_PROVIDER=echo
# MSTRMND_MODEL_PROVIDER=openai
# MSTRMND_MODEL_API_KEY=sk-...
# OPENAI_API_KEY=sk-...                    # fallback if MSTRMND_MODEL_API_KEY unset
# MSTRMND_MODEL_BASE_URL=https://api.openai.com/v1
# MSTRMND_MODEL_NAME=gpt-4o-mini
# MSTRMND_MODEL_ORG=

# MSTRMND OS (mstrmnd-os/) — hosting portability. See docs/portability.md.
# MSTRMND_STANDALONE=1                     # force the standalone Next.js build
# MSTRMND_SANDBOX=docker                   # auto | vercel | docker | microsandbox | justbash
# MSTRMND_SANDBOX_NETWORK=deny-all         # deny-all (default) | allow-all
# MSTRMND_SANDBOX_IMAGE=                   # base image for docker/microsandbox
# MSTRMND_WORKFLOW_WORLD=                  # Workflow world package (read at BUILD time)
# MSTRMND_PROVIDER=compatible              # compatible | gateway | anthropic | openai | xai | perplexity
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# AUTH_SECRET=                             # shared by the app and the agent
# MSTRMND_VGPU_MCP_URL=https://vgpu.sh/api/mcp  # or a local `npx vgpu mcp` URL
# MSTRMND_MODEL=                           # default / balanced Board hint
# MSTRMND_MODEL_FAST=                      # Board quality hint: fast
# MSTRMND_MODEL_CAPABLE=                   # Board quality hint: capable
# BOARD_DAILY_REQUEST_LIMIT=200            # per-workspace Board completions / UTC day
# BOARD_MAX_PROMPT_CHARS=48000             # max system + messages chars per turn
# BOARD_CORS_ORIGIN=*                      # Board web origin (or * in dev)
# MSTRMND_HOME=.mstrmnd                    # file home for Board budget/audit
# EXPO_PUBLIC_MSTRMND_API_URL=http://localhost:3001

# Portable host (apps/host) — API + MCP HTTP + ADK on :8080
# HOST=0.0.0.0
# PORT=8080
# MSTRMND_HOST_MODE=all                    # all | api | mcp | mcp-stdio | cli | calibrate | cron
# MSTRMND_CRON=1                           # supercronic inside the core image
# MSTRMND_PUBLIC_URL=http://localhost:8080
# MSTRMND_APPROVE_TOKEN=                   # required to publish drafts via HTTP
# MSTRMND_API_CORS_ORIGIN=*
# VERCEL_TOKEN=                            # optional read-only stack-tools live probe
# VERCEL_TEAM_ID=
# VERCEL_PROJECT=                          # project name or id for getProject
# GH_TOKEN=                                # optional; gh uses this or `gh auth login`
# MSTRMND_TOOLS_LIVE=0                     # 1 = hit Vercel/GitHub read-only from stack:tools

# Editorial worker (editorial_worker.py)
# MSTRMND_CORE=/Users/you/mstrmnd-core
# EDITORIAL_PYTHON=/Users/you/mstrmnd-core/.venv/bin/python
# EDITORIAL_ENGINE=~/.hermes/skills/creative/editorial-brand-system/scripts/generate_issue_kit.py
# EDITORIAL_KEY=mstrmnd-local
